# Compose env for the ephemeral crosshubber-e2e stack (non-secret structure only).
# Used by: docker compose -p crosshubber-e2e --env-file test/e2e/.env.e2e up -d --build
TENANT_SLUG=e2e
KC_PUBLIC_URL=http://localhost:28095
PGSCHEMA=e2e
REALM_NAME=e2e
TENANT_SECRETS_FILE=./config-management/tenants-config/e2e/secrets.env
TENANT_REALM_FILE=./config-management/tenants-config/e2e/realm.json
POSTGRES_DB=crosshubber_e2e
POSTGRES_USER=portal
KC_HOST_PORT=28095
PORTAL_HOST_PORT=28094
PG_HOST_PORT=25442
NATS_HTTP_PORT=32262