{
  "configVersion": 2,
  "slug": "_default",
  "name": "Portal Baseline",
  "description": "Complete default installation: all built-in embedded modules, the demo external modules and default settings. This profile is never deployed as a live tenant.",
  "baseline": true,
  "lifecycle": "persistent",
  "modules": {
    "builtin": {
      "portal-dashboard": true,
      "module-registry": true,
      "settings": true,
      "user-settings": true,
      "navigation": true,
      "i18n-settings": true,
      "ai-hub": true,
      "sample-embedded": true
    },
    "external": [
      { "key": "huey", "serviceKey": "huey", "manifestUrl": "http://huey:3000/.well-known/portal-module.json", "active": true },
      { "key": "louie-mfe", "serviceKey": "louie-mfe", "manifestUrl": "http://louie-mfe:80/.well-known/portal-module.json", "active": true }
    ]
  },
  "settings": {
    "homeApp": "navigation:portal",
    "pinnedAppsEnabled": true,
    "workspacesEnabled": true,
    "defaultTheme": "dark-slate"
  },
  "i18n": {
    "enabledLanguages": ["en-GB", "pt-PT", "fr-FR", "es-ES"],
    "defaultLanguage": "en-GB",
    "fallbackLanguage": "en-GB"
  },
  "branding": {
    "name": "Crosshubber",
    "title": "Crosshubber Portal"
  },
  "aiHub": { "enabledProviders": [] }
}