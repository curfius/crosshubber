{
  "manifestVersion": 1,
  "key": "staffing",
  "name": "Staffing",
  "baseUrl": "http://staffing:8091",
  "health": "/healthz",
  "content": {
    "applications": [
      {
        "key": "rfps",
        "name": "RFP Matcher",
        "description": "React to RFPs/RFQs and match the CV repository.",
        "type": "mfe",
        "path": "/mfe/main.js",
        "element": "staffing-rfps",
        "requiredRoles": ["staffing-user"]
      }
    ],
    "features": [],
    "adminSettings": [
      {
        "key": "settings",
        "name": "Staffing Settings",
        "description": "Configure tools, matching and the CV library connector.",
        "type": "mfe",
        "path": "/mfe/settings.js",
        "element": "staffing-settings",
        "requiredRoles": ["staffing-admin"]
      }
    ],
    "userSettings": []
  },
  "security": {
    "roles": [
      { "key": "staffing-user", "name": "Staffing User" },
      { "key": "staffing-admin", "name": "Staffing Admin" }
    ]
  },
  "capabilities": [],
  "events": { "published": [], "consumed": [] },
  "agentContributions": {
    "tools": [
      {
        "name": "list_rfps",
        "description": "List RFPs/RFQs with optional status filter.",
        "arguments": {
          "type": "object",
          "properties": { "status": { "type": "string", "description": "new|analyzing|matched|shortlisted|submitted|archived" } }
        },
        "mutates": false,
        "roles": ["staffing-user"]
      },
      {
        "name": "get_rfp",
        "description": "Get a full RFP record including extracted requirements.",
        "arguments": {
          "type": "object",
          "properties": { "rfpId": { "type": "string" } },
          "required": ["rfpId"]
        },
        "mutates": false,
        "roles": ["staffing-user"]
      },
      {
        "name": "search_cvs",
        "description": "Search the parsed CV repository; returns structured candidate profiles.",
        "arguments": {
          "type": "object",
          "properties": { "query": { "type": "string" } }
        },
        "mutates": false,
        "roles": ["staffing-user"]
      },
      {
        "name": "match_candidates",
        "description": "Rank candidates against an RFP (rfpId) or ad-hoc requirements; returns the top N with rationale.",
        "arguments": {
          "type": "object",
          "properties": {
            "rfpId": { "type": "string" },
            "requirements": { "type": "object" },
            "topN": { "type": "integer" }
          }
        },
        "mutates": false,
        "roles": ["staffing-user"]
      },
      {
        "name": "create_match_run",
        "description": "Run and persist a match for an RFP (mutating).",
        "arguments": {
          "type": "object",
          "properties": {
            "rfpId": { "type": "string" },
            "topN": { "type": "integer" }
          },
          "required": ["rfpId"]
        },
        "mutates": true,
        "roles": ["staffing-user"]
      }
    ],
    "skills": [],
    "agents": [],
    "knowledge": []
  }
}
