{
  "_comment": "Message-center schema-equivalence contract: both the TS task-form-model (vitest) and the server AllowlistSubmitValidator (JUnit) must produce the SAME verdict (accept/reject) for every case - plan checkpoints 3/4. NOTE: the browser test coerces empty-string values to null before evaluating (the UI never posts raw empty strings); raw empty-string rejection is server-side strictness only.",
  "fields": [
    { "name": "amount", "schema": { "type": "number", "minimum": 0, "maximum": 24 } },
    { "name": "days", "schema": { "type": "integer", "minimum": 1, "maximum": 30 } },
    { "name": "name", "schema": { "type": "string", "minLength": 2, "maxLength": 20 } },
    { "name": "code", "schema": { "type": "string", "pattern": "^[a-z]{3}$" } },
    { "name": "when", "schema": { "type": "string", "format": "date" } },
    { "name": "who", "schema": { "type": "string", "format": "email" } },
    { "name": "tier", "schema": { "type": "string", "enum": ["gold", "silver"] } },
    { "name": "optin", "schema": { "type": "boolean" } },
    { "name": "comment", "required": true, "schema": { "type": "string", "maxLength": 100 } }
  ],
  "cases": [
    { "field": "amount", "value": 3.5, "verdict": "accept" },
    { "field": "amount", "value": 24, "verdict": "accept" },
    { "field": "amount", "value": 24.01, "verdict": "reject" },
    { "field": "amount", "value": -0.5, "verdict": "reject" },
    { "field": "amount", "value": true, "verdict": "reject" },
    { "field": "amount", "value": 0, "verdict": "accept" },
    { "field": "days", "value": 1, "verdict": "accept" },
    { "field": "days", "value": 30, "verdict": "accept" },
    { "field": "days", "value": 2.5, "verdict": "reject" },
    { "field": "days", "value": 31, "verdict": "reject" },
    { "field": "name", "value": "ok", "verdict": "accept" },
    { "field": "name", "value": "x", "verdict": "reject" },
    { "field": "name", "value": 12345, "verdict": "reject" },
    { "field": "name", "value": null, "verdict": "accept" },
    { "field": "code", "value": "abc", "verdict": "accept" },
    { "field": "code", "value": "ABC", "verdict": "reject" },
    { "field": "code", "value": "abcd", "verdict": "reject" },
    { "field": "when", "value": "2026-10-07", "verdict": "accept" },
    { "field": "when", "value": "2026-2-3", "verdict": "reject" },
    { "field": "when", "value": "not-a-date", "verdict": "reject" },
    { "field": "who", "value": "a@b.co", "verdict": "accept" },
    { "field": "who", "value": "no-at-sign", "verdict": "reject" },
    { "field": "tier", "value": "gold", "verdict": "accept" },
    { "field": "tier", "value": "bronze", "verdict": "reject" },
    { "field": "tier", "value": "1", "verdict": "reject" },
    { "field": "optin", "value": true, "verdict": "accept" },
    { "field": "optin", "value": "yes", "verdict": "reject" }
  ],
  "requiredCase": { "field": "comment", "payload": {} }
}